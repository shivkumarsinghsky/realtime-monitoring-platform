# Copy to .env for running components on the host (`cp .env.example .env`). Never commit .env.
# Local development values matching docker-compose.yml; not secrets.
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC=$share/ingestion/telemetry/#

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://monitoring:monitoring-local-dev@localhost:5432/monitoring

# Event bus: redis (Redis Streams) or kafka
BUS=redis
KAFKA_BOOTSTRAP=localhost:9092
PARTITIONS=4

# Processor partition ownership (Redis Streams): this instance's index and the total processor count
PROCESSOR_INDEX=0
PROCESSOR_COUNT=1
CONSUMER_NAME=processor-0
RULES_FILE=config/rules.json

INGEST_QUEUE_SIZE=10000
INGEST_BATCH_SIZE=500
INGEST_FLUSH_MS=200
STALE_AFTER_SECONDS=60
RAW_RETENTION_DAYS=7
HTTP_PORT=8000
PROBE_TARGETS=api=http://localhost:8000/health/live
PROBE_INTERVAL_SECONDS=15
LOG_LEVEL=INFO
